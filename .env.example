# Скопируйте файл в .env и заполните. .env не попадает ни в git, ни в Docker-образ.

# Модель: любой OpenAI-совместимый API (POST /chat/completions, /embeddings, /rerank).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_REASONING_EFFORT=
EMB_MODEL=baai/bge-m3
RERANKER_MODEL=cohere/rerank-5-fast
EMBEDDER_API_KEY=
RERANKER_API_KEY=

# LLM_REASONING_EFFORT: пусто — как задано у провайдера; у Ollama значение none отключает размышления.
# Если провайдер не отдаёт /embeddings или /rerank, поиск сам переходит на лексику (TF-IDF),
# реранкер отключается; ответы при этом продолжают выдаваться.

# Пример: DeepSeek напрямую (модель DeepSeek V4.1 Flash).
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-flash

# Пример: Ollama на этой же машине, запуск через uv (без Docker).
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3.5:4b
# LLM_REASONING_EFFORT=none
# EMB_MODEL=bge-m3
# RERANKER_MODEL=

# Пример: Ollama на хосте, приложение в Docker. localhost внутри контейнера — это сам контейнер,
# поэтому адрес хоста — host.docker.internal. На Linux запустите Ollama с OLLAMA_HOST=0.0.0.0.
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3.5:4b
# LLM_REASONING_EFFORT=none
# EMB_MODEL=bge-m3
# RERANKER_MODEL=

# База знаний для веб-приложения: каталог с .txt/.md/.docx или zip-архив.
# Если каталога нет, берётся <KB_DIR>.zip, затем архив из DATA_DIR.
# В docker compose оба пути заданы в compose.yaml (./data монтируется в /kb только для чтения).
KB_DIR=data/knowledge-base
DATA_DIR=data

TEMPERATURE=0
MAX_TOKENS=1024
MAX_WORKERS=4
TOP_K=6
RERANKER_TOP_N=4
CHUNKER=common
PORT=8000

# Флаги пайплайна (1 — включено, 0 — выключено). Ниже значения по умолчанию.
USE_REASONING_EXTRACT=1
USE_NO_FORMAT_RETRY=1
USE_INJECTION_STRIP=1
USE_TIMELINE=1
USE_VERIFIER=1
USE_SELF_CHECK=1
USE_STEP7_PROMPT=1
USE_EXTRA_RULES=0
USE_S1_CHAT=1
USE_FULL_ANSWERS=0
USE_FACT_GUARDS=1
USE_REF_STYLE=0
